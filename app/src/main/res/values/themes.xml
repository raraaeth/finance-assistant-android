<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================================
         FINANCE ASSISTANT APP THEME
    ========================================== -->

    <style
        name="Theme.FinanceAssistant"
        parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- Primary -->
        <item name="colorPrimary">#1976D2</item>
        <item name="colorPrimaryVariant">#1565C0</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status Bar -->
        <item
            name="android:statusBarColor"
            tools:targetApi="l">
            #0D47A1
        </item>

        <!-- ActionBar -->
        <item name="actionBarStyle">
            @style/FinanceAssistantActionBar
        </item>

    </style>


    <!-- =========================================
         FINANCE ASSISTANT ACTION BAR
    ========================================== -->

    <style
        name="FinanceAssistantActionBar"
        parent="@style/Widget.MaterialComponents.ActionBar.Solid">

        <item name="android:background">#1976D2</item>
        <item name="background">#1976D2</item>

        <item name="titleTextStyle">
            @style/FinanceAssistantActionBarTitle
        </item>

    </style>


    <!-- =========================================
         ACTION BAR TITLE
    ========================================== -->

    <style
        name="FinanceAssistantActionBarTitle"
        parent="@style/TextAppearance.MaterialComponents.Headline6">

        <item name="android:textColor">@color/white</item>

    </style>

</resources>